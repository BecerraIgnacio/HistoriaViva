# Copiar a `.env` (que no se versiona) y completar. Lo lee `compose.yml`.

# Obligatorias y distintas entre sí. Claves largas en hexadecimal (van dentro de una URL):
# `openssl rand -hex 24`. POSTGRES_PASSWORD es la del superusuario; HV_CLAVE_MIGRADOR la del
# dueño del esquema; HV_CLAVE_APP la de la aplicación. Las tres se fijan al crear el volumen:
# para cambiarlas después, ver `db/bootstrap.sh`.
POSTGRES_PASSWORD=
HV_CLAVE_MIGRADOR=
HV_CLAVE_APP=

# Obligatoria. Directorio del host para los originales, fuera del OneDrive y del disco virtual
# de WSL (bind mount; lo cubren los backups).
HV_ORIGINALES=

# Opcional, solo en la PC. Carpeta del host con el conjunto de referencia del banco (DEC-120),
# fuera de git y del OneDrive, por ejemplo `D:\hv\referencia`. `web` la lee (la nota del banco en
# la pantalla de modelos) y `docker compose run --rm banco …` escribe en su `corridas` (runbook
# R8). Vacía: `web` arranca sin la nota y `banco` no corre. El servidor no la usa.
HV_REFERENCIA=

# Backups (spec §2.3, DEC-144, R-33). Los lee `python -m historia_viva.respaldo --entorno <este
# archivo>`, que se niega a correr si este `.env`, HV_VOLCADOS, HV_ORIGINALES, el repositorio o
# el archivo de la contraseña caen dentro del OneDrive o del disco virtual de WSL, o no son rutas
# absolutas.
# Obligatoria. Directorio local de los volcados (`pg_dump` y globales) y de `registro.jsonl`.
HV_VOLCADOS=
# Obligatoria. Repositorio de restic en el disco externo cifrado con BitLocker (por ejemplo
# `E:\historia-viva\restic`). Cambiar de disco es cambiar esta línea; después, `iniciar`.
RESTIC_REPOSITORY=
# Obligatoria una de las tres. La contraseña está en el gestor y en el sobre del Director, nunca
# en git: mejor RESTIC_PASSWORD_COMMAND, que la pide al gestor, que RESTIC_PASSWORD en claro.
RESTIC_PASSWORD_COMMAND=
RESTIC_PASSWORD_FILE=
RESTIC_PASSWORD=

# Los modelos no son variables: cada capacidad corre con su fila de `configuracion_capacidad`
# (RF-32), que se edita por SQL. Ahí también van los hilos de CPU del motor (`num_thread` en
# `parametros`; sin él, los elige Ollama). En CPU híbridas (núcleos P y E) conviene fijarlo:
# en un Core Ultra 7 255U, 6. Con 10 la generación cae a un tercio, porque los núcleos E
# frenan al resto.

# Modo de ingreso. Vacía es OIDC (DEC-37), lo seguro para el servidor. En la PC: `HV_AUTH=dev`
# y `HV_ENTORNO=desarrollo`; la persona entra con su email (DEC-112). `dev` sin
# `HV_ENTORNO=desarrollo` no arranca `web`.
HV_AUTH=

# En la PC, `desarrollo`: `migrar` siembra una persona de prueba por rol, que entra con su email,
# entre ellas la identidad RGC de prueba con la que se firma (DEC-124). Vacía es producción: en el
# servidor de la universidad queda así y la base nace sin personas (DEC-52).
HV_ENTORNO=

# El `Origin` de toda mutación (CSRF). Vacía es `http://localhost`, el de la PC: Caddy manda
# `http://127.0.0.1` ahí. En el servidor de la universidad, su URL.
HV_ORIGEN=

# Ingreso con Google (OIDC). Vacías: no hay botón de Google. El cliente lo entrega IT (C18); la
# URI de retorno que se le declara es `<HV_URL_PUBLICA>/auth/callback` (vacía: `http://localhost`).
# El secreto y la clave de la cookie previa (`openssl rand -hex 32`) no se loguean.
# HV_OIDC_EMISOR vacía es Google; la prueba de humo la apunta al proveedor falso.
HV_URL_PUBLICA=
HV_OIDC_CLIENTE_ID=
HV_OIDC_SECRETO=
HV_OIDC_EMISOR=

# Réplica de originales a Drive (124; se activa con C14/C34, 126). Vacía u `off`: apagada. `on`
# exige la unidad compartida, la carpeta y la clave JSON de la cuenta de servicio montada en
# `/run/secrets/drive_sa.json` (ver `compose.yml`); la clave no va en este archivo.
HV_DRIVE=
HV_DRIVE_UNIDAD=
HV_DRIVE_CARPETA=
HV_CLAVE_COOKIE_PREVIA=

# Dominios de email admitidos en `alta-persona` (y en OIDC), separados por comas. Vacía es el de
# la FIE, `fie.undef.edu.ar`.
HV_DOMINIOS_PERMITIDOS=

# Cupos por token de la API de Agentes (/v1): consultas y aportes por minuto, búsquedas en vuelo.
# Vacías: 60, 10 y 2 (propuesta para C15). Se ajustan acá, sin tocar código, y se reinicia web.
HV_CUPO_CONSULTAS_MIN=
HV_CUPO_APORTES_MIN=
HV_CUPO_BUSQUEDAS_EN_VUELO=
# Búsquedas con texto por minuto y por persona en /api/busqueda (165, SEG-09). Vacía: 30.
HV_CUPO_BUSQUEDAS_MIN=

# Similitud coseno mínima del mejor fragmento de una Ficha para que entre como Fuente en la
# Conversación y en /v1 (133). Vacía: 0.42, calibrado con bge-m3; si cambia el modelo de
# `embeber`, se vuelve a calibrar. 0 no corta nada. Se ajusta acá y se reinicia web.
HV_UMBRAL_SIMILITUD=

# Aprobación en bloque (108). Vacía o `false` hasta que la SEU acepte firmar sin abrir cada
# Pieza (C29, R-28): la pantalla solo lo explica y la API responde 409 `bloque-deshabilitado`.
HV_BLOQUE_HABILITADO=

# Controles de datos personales (125). Vacía o `false` hasta que la SEU y la asesoría jurídica
# decidan (C31): sin el campo «Publicable» en Validar, sin el aviso de DNI, CUIL o CBU y sin
# `suprimir` (runbook R14, docs/runbook-r14-supresion-efectiva.md).
HV_DATOS_PERSONALES_HABILITADOS=

# Imagen base de la app. Vacía: la del `compose.yml`, fijada por digest (SEG-04). Solo cambiarla si
# esa no baja (red con proxy), y con su digest: `python:3.12.16@sha256:…`.
IMAGEN_PYTHON=

# Modelos que `ollama` tiene cargados a la vez. Vacía es 2; el runbook R10 la baja a 1 si
# `ollama` muere por memoria.
OLLAMA_MAX_LOADED_MODELS=
# Servidor de la universidad (runbook R16). En la PC quedan vacías. En el servidor el `.env` lo
# arma `generar-env-servidor.sh`, con secretos nuevos y HV_AUTH, HV_URL_PUBLICA y HV_ORIGEN puestos.
# `servidor`: ningún servicio arranca con HV_ENTORNO y `web` exige OIDC completo y https.
HV_DESPLIEGUE=
# El nombre del servidor en el DNS de la FIE (C50) y el `tls` de Caddy (`compose.servidor.yml`):
# `internal` en la VM de prueba; `/certs/certificado.pem /certs/clave.pem` con el certificado de
# IT; o un correo, para Let's Encrypt, si el servidor sale a internet con un nombre público.
HV_DOMINIO=
HV_TLS=
# Directorio del host con los archivos del certificado de IT (se monta en /certs); vacío pero
# existente si HV_TLS es `internal` o un correo.
HV_CERTIFICADOS=
# Prueba de humo, solo en la VM (`compose.humo.yml`): el email del primer Administrador técnico.
HV_HUMO_ADMIN=
